Dialogue: 0,0:00:00.00,0:00:02.42,Default,,0,0,0,,Chào các bạn, hôm nay mình sẽ cùng thảo luận về một vấn đề khá phổ
Dialogue: 0,0:00:02.42,0:00:04.84,Default,,0,0,0,,biến mà nhiều người gặp phải: tại sao chúng ta luôn trì hoãn những việc quan trọng.
Dialogue: 0,0:00:04.84,0:00:07.26,Default,,0,0,0,,Ai trong số chúng ta không
Dialogue: 0,0:00:07.26,0:00:09.68,Default,,0,0,0,,từng để việc học bị lỡ ngày?
Dialogue: 0,0:00:09.68,0:00:12.10,Default,,0,0,0,,Hay làm việc nhà đến phút chót?
Dialogue: 0,0:00:12.10,0:00:14.66,Default,,0,0,0,,Trước hết, chúng ta hãy cùng tìm hiểu xem tại
Dialogue: 0,0:00:14.66,0:00:17.22,Default,,0,0,0,,sao việc trì hoãn lại trở thành một vấn đề lớn.
Dialogue: 0,0:00:17.22,0:00:19.78,Default,,0,0,0,,Khi chúng ta trì hoãn, không chỉ ảnh hưởng đến hiệu suất công
Dialogue: 0,0:00:19.78,0:00:22.34,Default,,0,0,0,,việc và học tập mà còn gây ra nhiều áp lực cho bản thân.
Dialogue: 0,0:00:22.34,0:00:24.05,Default,,0,0,0,,Nhiều người cho rằng mình trì hoãn vì không muốn làm việc.
Dialogue: 0,0:00:24.05,0:00:25.76,Default,,0,0,0,,Nhưng thực tế, nguyên nhân thường nằm ở tâm lý
Dialogue: 0,0:00:25.76,0:00:27.47,Default,,0,0,0,,lo sợ thất bại hoặc cảm thấy quá tải công việc.
Dialogue: 0,0:00:27.47,0:00:29.18,Default,,0,0,0,,Khi gặp khó khăn, chúng ta dễ dàng
Dialogue: 0,0:00:29.18,0:00:30.89,Default,,0,0,0,,tìm cách né tránh thay vì đối mặt.
Dialogue: 0,0:00:30.89,0:00:33.58,Interrupt,,0,0,0,,Nhưng thật ra, việc này chỉ càng
Dialogue: 0,0:00:33.58,0:00:36.26,Interrupt,,0,0,0,,khiến tình hình trở nên tệ hơn!
Dialogue: 0,0:00:36.26,0:00:38.33,Default,,0,0,0,,Còn nếu bạn đang cố gắng tập
Dialogue: 0,0:00:38.33,0:00:40.39,Default,,0,0,0,,trung vào quá nhiều thứ cùng lúc?
Dialogue: 0,0:00:40.39,0:00:41.98,Default,,0,0,0,,Điều này cũng đúng với tôi.
Dialogue: 0,0:00:41.98,0:00:43.56,Default,,0,0,0,,Khi có quá nhiều việc cần làm, ta dễ bị
Dialogue: 0,0:00:43.56,0:00:45.14,Default,,0,0,0,,phân tâm và không biết nên bắt đầu từ đâu.
Dialogue: 0,0:00:45.14,0:00:46.73,Default,,0,0,0,,Điều quan trọng là phải chia nhỏ công việc
Dialogue: 0,0:00:46.73,0:00:48.31,Default,,0,0,0,,thành các mục nhỏ hơn để xử lý từng bước.
Dialogue: 0,0:00:48.31,0:00:52.37,Interrupt,,0,0,0,,Chia nhỏ công việc thực sự giúp giảm tải cho bạn!
Dialogue: 0,0:00:52.37,0:00:56.52,Default,,0,0,0,,Và nếu bạn luôn gặp khó khăn với việc bắt đầu?
Dialogue: 0,0:00:56.52,0:00:58.65,Default,,0,0,0,,Đôi khi chúng ta trì hoãn vì
Dialogue: 0,0:00:58.65,0:01:00.78,Default,,0,0,0,,lo lắng không biết bắt đầu từ đâu.
Dialogue: 0,0:01:00.78,0:01:02.91,Default,,0,0,0,,Hãy thử đặt ra một mục tiêu cụ thể và thực hiện
Dialogue: 0,0:01:02.91,0:01:05.04,Default,,0,0,0,,từng bước nhỏ, từ đó tạo ra động lực cho bản thân.
Dialogue: 0,0:01:05.04,0:01:09.34,Interrupt,,0,0,0,,Những bước nhỏ có thể giúp bạn tiến bộ đáng kể!
Dialogue: 0,0:01:09.34,0:01:13.32,Default,,0,0,0,,Tuy nhiên, nếu bạn vẫn thấy khó khăn trong việc bắt đầu?
Dialogue: 0,0:01:13.32,0:01:14.77,Default,,0,0,0,,Có thể bạn chưa xác định được mục tiêu
Dialogue: 0,0:01:14.77,0:01:16.22,Default,,0,0,0,,rõ ràng hoặc không biết cách sắp xếp thời gian.
Dialogue: 0,0:01:16.22,0:01:17.68,Default,,0,0,0,,Hãy thử lên kế hoạch và ưu
Dialogue: 0,0:01:17.68,0:01:19.13,Default,,0,0,0,,tiên công việc để tránh bị trễ hạn.
Dialogue: 0,0:01:19.13,0:01:20.58,Default,,0,0,0,,Điều này giúp bạn tập trung
Dialogue: 0,0:01:20.58,0:01:22.03,Default,,0,0,0,,hơn vào những nhiệm vụ quan trọng.
Dialogue: 0,0:01:22.03,0:01:26.18,Interrupt,,0,0,0,,Khi có kế hoạch, mọi thứ sẽ dễ dàng hơn nhiều!
Dialogue: 0,0:01:26.18,0:01:26.76,Default,,0,0,0,,Nói tóm lại, để khắc phục tình trạng trì hoãn, bạn
Dialogue: 0,0:01:26.76,0:01:27.33,Default,,0,0,0,,cần hiểu rõ nguyên nhân và tìm cách giải quyết từng bước.
Dialogue: 0,0:01:27.33,0:01:27.90,Default,,0,0,0,,Hãy bắt đầu từ việc xác định mục
Dialogue: 0,0:01:27.90,0:01:28.47,Default,,0,0,0,,tiêu, lên kế hoạch, và chia nhỏ công việc.
Dialogue: 0,0:01:28.47,0:01:29.04,Default,,0,0,0,,Chỉ như vậy mới có thể tạo
Dialogue: 0,0:01:29.04,0:01:29.62,Default,,0,0,0,,ra động lực thực sự cho bản thân.
Dialogue: 0,0:01:29.62,0:01:32.28,Default,,0,0,0,,Nếu bạn muốn học cách vượt qua sự trì hoãn và trở nên hiệu quả hơn
Dialogue: 0,0:01:32.28,0:01:34.94,Default,,0,0,0,,trong công việc và cuộc sống hàng ngày, hãy tiếp tục theo dõi kênh của chúng tôi.
Dialogue: 0,0:01:34.94,0:01:37.61,Default,,0,0,0,,Đừng quên bấm nút đăng ký để nhận
Dialogue: 0,0:01:37.61,0:01:40.27,Default,,0,0,0,,thêm nhiều video hữu ích như thế này nhé.
